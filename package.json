{
  "name": "music-visualiser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite",
    "build": "vite build && node build-ssg.js",
    "build:prod": "npm run build",
    "preview": "vite preview",
    "deploy": "npm run build && npx firebase deploy",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.musicvisualiser.app",
    "productName": "Music Visualizer Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@xenova/transformers": "^2.17.2",
    "firebase": "^12.14.0",
    "jsmediatags": "^3.9.7",
    "mp4-muxer": "^5.2.2",
    "three": "^0.184.0"
  }
}
